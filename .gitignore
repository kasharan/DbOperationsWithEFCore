## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio 2022 / 2019 cache and folders
.vs/
.vscode/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml
nunit-*.xml

# BenchmarkDotNet
BenchmarkDotNet.Artifacts/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
**/Properties/launchSettings.json

# Tye
.tye/

# Entity Framework
**/Migrations/**/obj/
**/Migrations/bin/
*.dbmdl
*.jfm

# Database files
*.mdf
*.ldf
*.ndf
*.sqlite
*.db

# Auto generated EF Core scaffolding files backup
ScaffoldingReadMe.txt

# OS generated files
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio Coverage results
*.coverage
*.coveragexml

# Visual Studio Code workspace
*.code-workspace

# Rider
.idea/

# Windows image cache
*.lnk

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# DotCover
.idea/
*.dotCover

# SQL Server files
*.bak
*.sqlproj.user

# Azure publish settings
*.PublishSettings
*.azurePubxml

# Publish outputs
publish/
app.publish/
wwwroot/dist/
node_modules/

# Local history
.history/
.localhistory/

# TFS
$tf/

# Others
*.cache
*.config.user
*.pdb
*.mdb
*.opendb
*.pidb
*.svclog
*.scc

# npm, yarn, pnpm
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Backup & log files
*.bak
*.log
*.tlog

# Rider / JetBrains
.idea/
*.sln.iml

# Visual Studio for Mac
*.pidb
*.userprefs

# Rider & Resharper settings
.idea/
*.sln.iml

# Visual Studio Generated FileContentIndex files
.vs*/FileContentIndex/

# Temporary
temp/
tmp/

# Optional: if using secrets.json for dev configuration
**/appsettings.Development.json
**/appsettings.Local.json
**/secrets.json
